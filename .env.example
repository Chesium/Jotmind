# Copy to .env and adjust for your environment.

# Canonical PostgreSQL connection string (Apache AGE + pgvector).
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jotmind

# PostgreSQL container credentials (used by docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jotmind

# API bind address. Defaults to localhost; LAN binding is an explicit opt-in.
HOST=127.0.0.1
PORT=3001
