# Copy to .env and adjust for your environment.

# Canonical PostgreSQL connection string (Apache AGE + pgvector).
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jotmind

# PostgreSQL container credentials (used by docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jotmind

# API bind address. Defaults to localhost; LAN binding is an explicit opt-in.
HOST=127.0.0.1
PORT=3001

# Mark session/CSRF cookies as Secure (HTTPS-only). Defaults to true in
# production (NODE_ENV=production). Set to true behind a TLS reverse proxy.
COOKIE_SECURE=false

# Run the durable-jobs worker in-process (US-007). Set to true for the
# single-container Docker setup; run a separate `worker` process at scale.
WORKER_INLINE=true

# Serve the built web assets from the API for a single-origin deployment
# (US-033). Point at the web build output; leave unset to serve JSON only.
# WEB_DIST_PATH=/app/apps/web/dist

# Exact-match CORS allowlist (comma-separated origins) for deploying the web app
# on a DIFFERENT origin than the API (US-033). Empty = same-origin only; `*` is
# never honored (it is incompatible with cookie auth). Example:
# CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=

# Docker Compose host-binding for the API service (US-033). Defaults to
# localhost; opt in to LAN exposure with API_BIND=0.0.0.0.
# API_BIND=127.0.0.1
# API_PORT=3001

# Build-time API base URL for the web app when deployed as static assets on a
# different origin than the API (US-033). Empty = relative /api paths (the Vite
# dev proxy / single-origin setup). Set before `pnpm --filter @jotmind/web build`.
# VITE_API_BASE_URL=https://api.example.com
