{
  "name": "jotmind",
  "version": "0.0.0",
  "private": true,
  "description": "JotMind - privacy-first, self-hostable graph-based personal knowledge app",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --filter=!@jotmind/api test",
    "test:api": "pnpm --filter @jotmind/api test",
    "test:e2e": "pnpm --filter @jotmind/web test:e2e",
    "verify:quick": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:api && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.14.10",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  }
}
